  async function civStory() {
    app.state.setParams({ coop: 0.92, eco: 0.88, openness: 0.72, reform: 0.78 });
    const go = dir.goTo('civ');
    say('镜头穿过云层，落在一张会自己写历史的大陆上。', 5.8);
    await go;
    await wait(1.0);
    const c = dir.acts.civ;
    clean(true);
    chapter('civ');
    await app.rig.to(app.tw, { target: V3(), dist: 8.5, el: 0.90, az: 0.28 }, 2100);
    await wait(1.0);
    // Generate a low-cooperation branch first. This becomes the grey ghost of the rewritten history.
    c.setPlaying(false);
    c.newRun({ coop: 0.12, eco: 0.35, openness: 0.45, reform: 0.42 }, false);
    await advanceSandbox(c, 900);
    app.state.setLayer(4, 'fail');
    card({ kick: '分支 A · 未修正历史', title: c.sb.fate || '文明中断', accent: '#ff6152',
      lines: [`沙盘第 ${Math.round(c.sb.year)} 年，世界人口 ${Math.round(c.sb.worldPop())} 万`, '冲突与生态张力越过阈值，旧历史在这里断裂'], hold: 5.6 });
    await sayWait('如果合作缺席，城市会扩张，也会在冲突中失去一切。', 5.5);
    say('文明不是一条注定向上的线，它会在同一个沙盘里分叉。', 5.2);
    const back = 0;
    // Rewind using the actual engine, then write a different branch with high cooperation.
    app.state.setParams({ coop: 0.92, eco: 0.88, openness: 0.72, reform: 0.78 });
    c.userRun = false;
    c.rewind(back);
    c.setSpeed(8);
    c.setPlaying(true);
    clean(false);
    app.panel.el.scrollTop = 0;
    await wait(5.2);
    await sayWait('回卷到文明起点：提高合作，约束生态张力，再推演一次。', 5.8);
    await until(() => !!c.sb?.done, 16);
    c.setPlaying(false);
    c.table.sync(true);
    c.refreshUi(true);
    c.refresh();
    const ok = c.sb.fate === '延续';
    app.state.setLayer(4, ok ? 'ok' : 'fail');
    if (ok) {
      const pv = q('.panel .verdict', app.panel.el);
      if (pv) highlight(pv, '参数重写 · 文明延续', 3.5, 'left');
      await sayWait('这一次，文明延续了下来。灯火星罗棋布，历史被改写。', 6.2);
    }
    else await sayWait('即便做出修正，文明仍在风险边缘摇摆。这正是概率实验的意义。', 6.2);
    // Close-up: an actual settlement selected on the actual sand table.
    clean(false);
    await wait(0.5);
    const cities = c.sb.settlements.filter((s) => s.pop > 0 && !s.ruined).sort((a, b) => b.pop - a.pop);
    const big = cities[1] || cities[0];
    if (big) {
      const world = c.table.settlementPos(big.id).applyMatrix4(c.table.group.matrixWorld);
      await showCursor(true);
      const sp = project(world);
      await moveTo(sp.x, sp.y, 0.8);
      ripple(cur.x, cur.y, '#3ff2e6');
      sfx('click');
      c.click(big.y * 72 + big.x, big);
      await app.rig.to(app.tw, { target: world, dist: 1.35, el: 0.58, az: 0.55 }, 2800);
      await wait(2.4);
      await showCursor(false);
      app.panel.el.scrollTop = 0;
      clean(true);
      await wait(2.0);
      await sayWait('每一处灯火都是一座城市：耕作、贸易、战争、变革。', 5.4);
    }
    // Show the ghost fork in the actual double-ring chart.
    clean(false);
    await app.rig.to(app.tw, { target: V3(), dist: 8.6, el: 0.92, az: 0.28 }, 2100);
    await wait(1.2);
    const head = [...app.panel.el.querySelectorAll('.sec-head')].find((b) => b.textContent.includes('双环'));
    if (head && head.closest('.sec')?.classList.contains('shut')) await click(head);
    const chart = q('canvas.chart', app.panel.el);
    if (chart) {
      await scrollPanelToEl(chart, 0.7);
      highlight(chart.closest('.sec') || chart, '灰色虚线：被改写的旧分支', 4.0, 'left');
    }
    await sayWait('历史可以回卷，参数可以重写；旧分支保留为对照，新历史立刻生长。', 5.8);
    clean(true);
    await wait(0.8);
  }

