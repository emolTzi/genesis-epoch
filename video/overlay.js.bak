  /* ═══════════════ 主线：作品自身的导览 ═══════════════ */
  async function intoApp() {
    say('下面是作品的实际运行画面。', 2.6);
    const boot = q('.boot');
    void fadeBg(0, 1.4);
    void tween(1.2, (k) => (stars.op = 1 - k));
    await wait(1.0);
    await showCursor(true);
    const btn = boot && boot.querySelector('.choices .btn.primary');
    await click(btn, () => {
      spine = true;
      document.body.classList.add('film-spine');
      btn.click();
    });
    void showCursor(false);
  }

  /* ═══════════════ 导演 ═══════════════ */
  /* ═══════════ 新剪辑：一条从宇宙到地球、从概率到选择的线性故事 ═══════════ */
  const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];
  const byText = (sel, needle, root = document) => $$(sel, root).find((x) => x.textContent.replace(/\s+/g, '').includes(needle));
  const V3 = (x = 0, y = 0, z = 0) => app.rig.target.clone().set(x, y, z);
  const clean = (on) => document.body.classList.toggle('film-clean', on);
  const closeModal = async () => {
    const b = byText('.modal button', '进入文明') || byText('.modal button', '回到实验舱') || byText('.modal button', '继续') || q('.modal .btns .btn.primary');
    if (b) await click(b);
  };
  async function sayWait(text, hold = 5) {
    say(text, hold);
    await wait(hold);
  }
  async function scrollPanelToEl(target, dur = 0.7) {
    if (!target) return;
    const panel = app.panel.el;
    const box = target.closest ? target.closest('.sec') || target : target;
    const pr = panel.getBoundingClientRect();
    const br = box.getBoundingClientRect();
    const from = panel.scrollTop;
    const to = Math.max(0, from + br.top - pr.top - 68);
    await tween(dur, (k) => (panel.scrollTop = lerp(from, to, k)));
  }
  async function advanceSandbox(c, ticks, resolveCrisis = true) {
    c.setPlaying(false);
    let n = 0;
    while (!c.sb.done && n < ticks) {
      c.sb.step();
      if (resolveCrisis && c.sb.pendingCrisis) c.sb.resolveCrisis('wait');
      n++;
    }
    c.table.sync(true);
    c.feed.clear();
    c.feed.push(c.sb.events.slice(-16));
    c.refreshUi(true);
    c.refresh();
    await wait(0.35);
  }

  async function openingFilm() {
    document.body.classList.add('film-own');
    clean(true);
    setBg(1);
    stars.op = 0;
    app.stage.qualityMode = 'high';
    app.stage.setQualityMode('high');
    app.audio.setEnabled(false);
    await wait(0.2);
    await coldOpen();
    await titleCard();
    await structure();
    stars.warp = 0;
    const fade = fadeBg(0, 1.5);
    void tween(1.25, (k) => (stars.op = 1 - k));
    await fade;
    say('下面，是你的实验室。', 2.8);
    await wait(0.8);
    await showCursor(true);
    const free = byText('.boot .choices button', '自由探索');
    await click(free);
    await until(() => app.state.mode === 'free' && !!q('.modal .ranks'), 8);
    const bootEl = q('.boot');
    if (bootEl) { bootEl.style.transition = 'opacity .5s ease'; bootEl.style.opacity = '0'; setTimeout(() => bootEl.remove(), 700); }
    await wait(0.8);
    const rank = $$('.modal .ranks button')[4] || $$('.modal .ranks button')[2];
    if (rank) await click(rank);
    await wait(0.7);
    const ok = byText('.modal button', '校准完成');
    if (ok) await click(ok);
    await until(() => { const m = q('.modal-wrap'); return !m || m.hidden; }, 8);
    await showCursor(false);
    clean(false);
    await app.rig.to(app.tw, { target: V3(), dist: 8.7, el: 0.16, az: 0.48 }, 1600);
    app.armillary.show(6);
    await wait(0.9);
  }

